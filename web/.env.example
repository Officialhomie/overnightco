# ─── Locus ───────────────────────────────────────────────────────────────────
# Single key for all Locus interactions:
#   - Creating checkout sessions (human $2 purchases)
#   - Calling Locus Wrapped APIs (Exa, Claude) — costs deducted per call
#   - Sending profit payouts via POST /pay/send
#   - Checking balance
LOCUS_API_KEY=

# Optional: override Locus API base URL (default: beta)
LOCUS_API_BASE=https://beta-api.paywithlocus.com/api

# HMAC secret Locus sends with webhook POST bodies (x-locus-signature header)
LOCUS_WEBHOOK_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL — paste from Neon Dashboard → Connection string (use the
# pooled "Transaction" string for serverless / many short-lived connections).
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# NextAuth JWT signing secret — generate with: openssl rand -hex 32
AUTH_SECRET=

# Public app URL — must be https:// for production (Locus rejects localhost webhooks)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Shared secret for Vercel Cron → /api/internal/* routes
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Access Tokens ───────────────────────────────────────────────────────────
# HMAC signing secret for reader/agent access tokens (after payment confirmation)
# Generate: openssl rand -hex 32
ACCESS_TOKEN_SECRET=

# ─── Content Defaults ─────────────────────────────────────────────────────────
# Default prices in USDC (can be changed in dashboard settings)
HUMAN_PRICE_USDC=2.00
AGENT_PRICE_USDC=0.50

# Default payout wallet (can be set in dashboard settings)
DEFAULT_PAYOUT_WALLET=

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to run the full business loop in 90 seconds with cached responses
# Never use in production
DEMO_MODE=false

# ─── Owner Account (for seeding only) ────────────────────────────────────────
OWNER_EMAIL=owner@overnightco.xyz
OWNER_PASSWORD=

# ─── Development ─────────────────────────────────────────────────────────────
# Set to "1" in tests to stub Locus API calls — never in production
MOCK_LOCUS=
